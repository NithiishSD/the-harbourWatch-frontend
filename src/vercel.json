{
  "rewrites": [
    {
      "source": "/static/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/api/alerts/stream",
      "destination": "https://YOUR_API_DOMAIN/api/alerts/stream"
    },
    {
      "source": "/api/:path*",
      "destination": "https://YOUR_API_DOMAIN/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://YOUR_API_DOMAIN/health"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/:file.(js|css)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, immutable" }
      ]
    }
  ]
}
