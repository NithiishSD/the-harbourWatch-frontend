{
  "rewrites": [
    {
      "source": "/static/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/api/alerts/stream",
      "destination": "https://43-205-253-177.nip.io/api/alerts/stream"
    },
    {
      "source": "/api/:path*",
      "destination": "https://43-205-253-177.nip.io/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://43-205-253-177.nip.io/health"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/:file.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, immutable"
        }
      ]
    }
  ]
}